# PayOS - lấy tại https://my.payos.vn (Kênh thanh toán)
PAYOS_CLIENT_ID=YOUR_PAYOS_CLIENT_ID
PAYOS_API_KEY=YOUR_PAYOS_API_KEY
PAYOS_CHECKSUM_KEY=YOUR_PAYOS_CHECKSUM_KEY

# URL frontend (trang return/cancel sau thanh toán)
PAYOS_FRONTEND_URL=http://localhost/DATTDN/vk-global-html

# Webhook URL (production cần HTTPS; local dùng ngrok)
PAYOS_WEBHOOK_URL=http://localhost/DATTDN/backend/public/api/payments/payos/webhook
